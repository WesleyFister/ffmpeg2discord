FROM debian:bookworm-20261123-slim

# Install system dependencies for PyInstaller, PyQt6, FFmpeg, and AppImage
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    git \
    jpegoptim \
    file \
    # Python toolchain
    python3 \
    python3-pip \
    libpython3.11-dev \
    # Runtime libraries
    libgtk-3-0 \
    libdbus-1-3 \
    libglib2.0-0 \
    libgl1 \
    libegl1 \
    libfontconfig1 \
    libfreetype6 \
    libharfbuzz0b \
    libxkbcommon0 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-render-util0 \
    libxcb-shape0 \
    libxcb-cursor0 \
    libxcb-util1 \
    libxcb-xkb1 \
    libxkbcommon-x11-0 \
    # Toolchain for the FFmpeg/SVT-AV1 compile further down.
    build-essential \
    cmake \
    nasm \
    pkg-config \
    # Codec libraries that FFmpeg configures against.
    libx264-dev \
    libvpx-dev \
    libopus-dev \
    libdav1d-dev \
    libwebp-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Download and install appimagetool for AppImage packaging
RUN curl -sfL -o appimagetool https://github.com/AppImage/appimagetool/releases/download/1.9.1/appimagetool-x86_64.AppImage \
    && chmod +x appimagetool \
    && ./appimagetool --appimage-extract \
    && mv squashfs-root /opt/appimagetool \
    && ln -s /opt/appimagetool/AppRun /usr/local/bin/appimagetool \
    && rm appimagetool

# Compile ffmpeg/ffprobe and SVT-AV1 into the image.
COPY scripts/build-deps.sh /usr/local/bin/build-deps.sh
RUN bash /usr/local/bin/build-deps.sh /opt/ffmpeg2discord/tools

# Install Python dependencies and PyInstaller. Debian's system Python is PEP 668
# "externally managed", so --break-system-packages is required to pip-install into it.
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --break-system-packages -r /tmp/requirements.txt 'pyinstaller==6.22.3'

# The default command can be overridden by the CI/CD pipeline or user
CMD ["/bin/bash"]
